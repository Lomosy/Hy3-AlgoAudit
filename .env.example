# ============================================================
#  Hy3-AlgoAudit 环境变量示例
#  用法：复制本文件为 .env 并填入真实值。
#  注意：.env 已被 .gitignore 忽略，切勿将真实密钥提交进仓库。
# ============================================================

# --- Hy3 模型调用（OpenAI 兼容接口） ---

# API 服务地址（犀牛鸟活动提供的端点，或自部署 vLLM/SGLang 服务的地址）
HY3_BASE_URL=

# API Key（活动提供的密钥；本地自部署时可为 EMPTY）
HY3_API_KEY=

# 模型名（默认 hy3）
HY3_MODEL_NAME=hy3

# 推理强度：no_think（直接回答）/ low / high（深度思维链，适合算法推理）
HY3_REASONING_EFFORT=high

# 采样参数（可选，官方推荐默认值）
HY3_TEMPERATURE=0.9
HY3_TOP_P=1.0

# 请求超时与重试（可选）
HY3_TIMEOUT_SECONDS=300
HY3_MAX_RETRIES=3
